datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum QrStatus {
  ACTIVE
  PAUSED
  DELETED
}

enum LinkType {
  STATIC
  DYNAMIC
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  password              String
  name                  String?
  role                  String    @default("user")
  trialEndsAt           DateTime?
  resetToken            String?   // SHA-256 of the emailed token, never the token itself
  resetTokenExpires     DateTime?
  emailVerifiedAt       DateTime? // set once the emailed 6-digit code is entered; the dashboard needs it
  emailCodeHash         String?   // HMAC of the current verification code (never the code itself)
  emailCodeExpiresAt    DateTime?
  emailCodeAttempts     Int       @default(0) // wrong tries for the current code
  emailCodeSentAt       DateTime? // for the resend cooldown
  pendingEmail          String?   // new address waiting for its code (account page); `email` changes only once confirmed
  termsAcceptedAt       DateTime? // when they ticked "I agree to the Terms of Service and Privacy Policy"
  sessionVersion        Int       @default(0) // bumped on password change/reset to sign out every existing session
  subscriptionPlan      String    @default("EXPIRED") // TRIAL | BASIC | EXPIRED
  trialStartedAt        DateTime?
  subscriptionStartedAt DateTime?
  subscriptionEndsAt    DateTime?

  // Razorpay subscription linkage (optional)
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  razorpayLastPaymentId  String?
  lastPlanEmailKey       String?   // subscription ID ("plan active" emails) or payment ID (renewals) last emailed about, so each is sent once
  
  // General Information (Account)
  telephone             String?
  company               String?
  address               String?
  city                  String?
  state                 String?
  zipCode               String?
  country               String?
  language              String?  @default("English")
  
  // Billing Information
  billingName           String?
  billingCompany        String?
  billingAddress        String?
  billingCity           String?
  billingState          String?
  billingZipCode        String?
  billingCountry        String?
  taxId                 String?
  
  qrCodes               QRCode[]
  folders               Folder[]
  invoices              Invoice[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model QRCode {
  id                String    @id @default(cuid())
  slug              String    @unique
  type              String    @default("website")
  targetUrl         String
  name              String?
  qrColor           String    @default("#000000")
  bgColor           String    @default("#ffffff")
  meta              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  scanCount         Int       @default(0)
  deactivatedReason String?   // TRIAL_EXPIRED | SUBSCRIPTION_EXPIRED | MANUAL | null
  status            QrStatus  @default(ACTIVE) // ACTIVE | PAUSED | DELETED
  linkType          LinkType  @default(DYNAMIC) // STATIC = no tracking, DYNAMIC = /r/slug + tracking
  pausedMessage    String?   // configurable "QR paused" landing text
  passwordHash      String?   // bcrypt hash; when set, scanners must enter the password first (dynamic codes only)
  user              User?     @relation(fields: [userId], references: [id])
  userId            String?
  folder            Folder?   @relation(fields: [folderId], references: [id])
  folderId          String?
  scanEvents        ScanEvent[]
}

model ScanEvent {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  userAgent       String?
  ip              String?  // optional truncated IP; prefer ipHash for privacy
  ipHash          String?  // hashed IP for unique counts and privacy
  os              String?
  deviceType     String?  // mobile | desktop | tablet
  browser         String?
  referer         String?
  country         String?
  region          String?
  city            String?
  blockedByStatus Boolean  @default(false) // true when hit was to a paused QR (if we log it)

  qrCode    QRCode @relation(fields: [qrCodeId], references: [id])
  qrCodeId  String
}


// Messages from the /contact form; kept so none are lost if email delivery fails
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  topic     String
  message   String
  userId    String?  // set when the sender was signed in
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// GST tax invoice for one Razorpay payment (lib/invoices.js). Seller and customer details are copied in as printed,
// so an invoice never changes afterwards. Kept if the account is deleted: tax records must be retained.
model Invoice {
  id                     String    @id @default(cuid())
  number                 String    @unique // QG/2026-27/0001
  financialYear          String    // 2026-27 (April to March); numbers restart each year
  sequence               Int
  issuedAt               DateTime  @default(now())
  user                   User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId                 String?
  razorpayPaymentId      String    @unique // one invoice per payment, however often checkout or webhooks report it
  razorpaySubscriptionId String?
  paidAt                 DateTime
  paymentMethod          String?
  currency               String    // INR | USD
  total                  Int       // amount paid, GST included, in paise / cents
  taxableValue           Int
  cgst                   Int       @default(0)
  sgst                   Int       @default(0)
  igst                   Int       @default(0)
  supplyType             String    // INTRA_STATE | INTER_STATE | EXPORT_WITH_IGST | EXPORT_LUT
  placeOfSupply          String    // "Gujarat (24)", "Outside India (96)"
  description            String
  periodStart            DateTime?
  periodEnd              DateTime?
  seller                 Json      // { name, address[], gstin, sac, lutArn }
  customer               Json      // { name, company, email, address[], gstin, taxId }
  emailedAt              DateTime? // set when the invoice email went out (claimed before sending)

  @@unique([financialYear, sequence])
  @@index([userId])
}

// Last invoice number used in each financial year
model InvoiceCounter {
  financialYear String @id
  last          Int    @default(0)
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  qrCodes   QRCode[]
  createdAt DateTime @default(now())
}

