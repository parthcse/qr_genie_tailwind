# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection. Use only letters and digits in the password, or URL-encode it.
DATABASE_URL="postgresql://qr_genie:CHANGE_ME@localhost:5432/qr_genie?schema=public"

# Public site address. Baked into QR codes (/r/<slug>) and email links; set at build time.
# Locally use http://localhost:3000 so test codes don't point at the live site.
NEXT_PUBLIC_BASE_URL="https://qr-genie.co"
# Optional; defaults to NEXT_PUBLIC_BASE_URL
# NEXT_PUBLIC_APP_URL="https://qr-genie.co"

# Signs login cookies. Generate with: openssl rand -hex 32
JWT_SECRET=""

# Salt for hashing scanner IP addresses in analytics. Generate with: openssl rand -hex 32
SCAN_IP_HASH_SECRET=""

# Razorpay: Dashboard -> Account & Settings -> API Keys. Use rzp_test_ keys locally.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Basic Package plans, one per currency: Dashboard -> Subscriptions -> Plans (same Live/Test mode as the keys).
# A currency is offered only when its plan is set; set one for INR-only or USD-only. Prices shown on the site
# are read from these plans. (Older setups: RAZORPAY_BASIC_PLAN_ID still works; its currency is read from the plan.)
RAZORPAY_PLAN_ID_INR=""
RAZORPAY_PLAN_ID_USD=""
# Dashboard -> Webhooks -> your webhook -> Secret
RAZORPAY_WEBHOOK_SECRET=""

# Cloudflare Turnstile bot check on the sign-up, login, password-reset and contact forms
# (Cloudflare dashboard -> Turnstile -> your widget, mode: Managed, hostname qr-genie.co).
# Locally use the test keys, which always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
# Leave both empty to turn the check off, e.g. locally. The site key is public; the secret stays on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Outgoing email over SMTP: password resets, contact-form notifications and plan emails (plan active / renewed
# to the customer, new subscriber / renewal to the admin). For AWS SES:
#   SES console -> Verified identities: verify your domain (add the DKIM DNS records)
#   SES console -> SMTP settings: the SMTP endpoint for your region, and Create SMTP credentials
#   (these are NOT your AWS access keys)
#   SES starts in a sandbox that only sends to verified addresses: request production access to email customers.
# Leave empty to print emails to the server log instead (contact messages are still saved in the database).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="QR Genie <noreply@qr-genie.co>"

# Where new-subscriber and renewal notices go (comma-separated for several). Empty = the support inbox (lib/site.js).
ADMIN_NOTIFY_EMAIL=""

# Where contact-form messages go (comma-separated for several). Empty = the support inbox (lib/site.js).
CONTACT_NOTIFY_EMAIL=""
